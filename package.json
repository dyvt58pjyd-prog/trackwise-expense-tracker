{
  "name": "offline-expense-tracker",
  "private": true,
  "version": "1.0.0",
  "author": "Anurag Bawaskar",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "electron:dev": "ELECTRON=true npm run build && electron electron/main.js",
    "electron:start": "ELECTRON=true npm run build && electron electron/main.js",
    "mac:build": "ELECTRON=true npm run build && electron-builder --mac --arm64 --dir",
    "mac:dmg": "ELECTRON=true npm run build && electron-builder --mac --arm64",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:build": "npm run build && npx cap sync android && cd android && ./gradlew assembleDebug"
  },
  "build": {
    "appId": "com.trackwise.finance.desktop",
    "productName": "TrackWise Finance",
    "mac": {
      "category": "public.app-category.finance",
      "target": [
        "dir",
        "dmg"
      ],
      "icon": "public/icon-512.png",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ]
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@neondatabase/serverless": "^1.2.1",
    "@supabase/supabase-js": "^2.119.2",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^1.1.7",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-pwa": "^0.21.1"
  }
}
